      "source": [
        "import hashlib\n",
        "\n",
        "# Small demonstration values\n",
        "p = 467\n",
        "g = 2\n",
        "\n",
        "# Private key\n",
        "x = 127\n",
        "\n",
        "# Public key\n",
        "y = pow(g, x, p)\n",
        "\n",
        "def hash_message(message):\n",
        "    return int(\n",
        "        hashlib.sha256(message.encode()).hexdigest(),\n",
        "        16\n",
        "    )\n",
        "\n",
        "def sign(message):\n",
        "    h = hash_message(message)\n",
        "\n",
        "    # Choose k such that gcd(k, p-1) = 1\n",
        "    k = 3\n",
        "\n",
        "    # r = g^k mod p\n",
        "    r = pow(g, k, p)\n",
        "\n",
        "    # Find inverse of k modulo p-1\n",
        "    k_inverse = pow(k, -1, p - 1)\n",
        "\n",
        "    # s = k^-1(h - xr) mod (p-1)\n",
        "    s = (k_inverse * (h - x * r)) % (p - 1)\n",
        "\n",
        "    return r, s\n",
        "\n",
        "\n",
        "def verify(message, signature):\n",
        "    r, s = signature\n",
        "\n",
        "    h = hash_message(message)\n",
        "\n",
        "    left = (pow(y, r, p) * pow(r, s, p)) % p\n",
        "    right = pow(g, h, p)\n",
        "\n",
        "    return left == right\n",
        "\n",
        "\n",
        "message = \"Hello ElGamal\"\n",
        "\n",
        "signature = sign(message)\n",
        "\n",
        "print(\"Message:\", message)\n",
        "print(\"Public Key:\", y)\n",
        "print(\"Signature:\", signature)\n",
        "\n",
        "print(\"Verification:\", verify(message, signature))\n",
        "\n",
        "modified = \"Modified message\"\n",
        "\n",
        "print(\"Modified Message:\", modified)\n",
        "print(\"Verification:\", verify(modified, signature))"
