        "import hashlib\n",
        "import hmac\n",
        "\n",
        "message = \"Transfer Rs.1000\"\n",
        "\n",
        "key = b\"secretkey\"\n",
        "\n",
        "# Simple hash\n",
        "simple_hash = hashlib.sha256(message.encode()).hexdigest()\n",
        "\n",
        "# HMAC\n",
        "hmac_value = hmac.new(\n",
        "    key,\n",
        "    message.encode(),\n",
        "    hashlib.sha256\n",
        ").hexdigest()\n",
        "\n",
        "print(\"Message:\", message)\n",
        "print(\"Simple SHA-256:\", simple_hash)\n",
        "print(\"HMAC-SHA256:\", hmac_value)\n",
        "\n",
        "# Verify HMAC\n",
        "check = hmac.compare_digest(\n",
        "    hmac_value,\n",
        "    hmac.new(key, message.encode(), hashlib.sha256).hexdigest()\n",
        ")\n",
        "\n",
        "print(\"HMAC Verification:\", check)"
      ],
