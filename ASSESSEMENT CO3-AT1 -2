        "import hashlib\n",
        "\n",
        "# RSA public/private parameters\n",
        "p = 61\n",
        "q = 53\n",
        "\n",
        "n = p * q\n",
        "phi = (p - 1) * (q - 1)\n",
        "\n",
        "e = 17\n",
        "d = 2753\n",
        "\n",
        "def hash_message(message):\n",
        "    return int(hashlib.sha256(message.encode()).hexdigest(), 16)\n",
        "\n",
        "def sign(message):\n",
        "    h = hash_message(message)\n",
        "    return pow(h, d, n)\n",
        "\n",
        "def verify(message, signature):\n",
        "    h = hash_message(message)\n",
        "    recovered_hash = pow(signature, e, n)\n",
        "\n",
        "    return recovered_hash == h % n\n",
        "\n",
        "\n",
        "# Message\n",
        "message = \"This is a secret message\"\n",
        "\n",
        "# Generate signature\n",
        "signature = sign(message)\n",
        "\n",
        "print(\"Message:\", message)\n",
        "print(\"Signature:\", signature)\n",
        "\n",
        "# Verify original message\n",
        "print(\"Verification:\", verify(message, signature))\n",
        "\n",
        "# Modify message\n",
        "modified_message = \"This is a modified message\"\n",
        "\n",
        "print(\"Modified Message:\", modified_message)\n",
        "print(\"Verification:\", verify(modified_message, signature))"
