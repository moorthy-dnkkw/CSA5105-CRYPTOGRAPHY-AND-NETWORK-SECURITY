        "import hashlib\n",
        "import time\n",
        "import hmac\n",
        "\n",
        "# Secret keys\n",
        "client_key = b\"client_secret\"\n",
        "server_key = b\"server_secret\"\n",
        "\n",
        "def create_ticket(username):\n",
        "    timestamp = str(int(time.time()))\n",
        "\n",
        "    data = username + \"|\" + timestamp\n",
        "\n",
        "    ticket = hmac.new(\n",
        "        server_key,\n",
        "        data.encode(),\n",
        "        hashlib.sha256\n",
        "    ).hexdigest()\n",
        "\n",
        "    return username, timestamp, ticket\n",
        "\n",
        "\n",
        "def validate_ticket(username, timestamp, ticket):\n",
        "    current_time = int(time.time())\n",
        "    ticket_time = int(timestamp)\n",
        "\n",
        "    # Ticket valid for 30 seconds\n",
        "    if current_time - ticket_time > 30:\n",
        "        return False\n",
        "\n",
        "    data = username + \"|\" + timestamp\n",
        "\n",
        "    expected_ticket = hmac.new(\n",
        "        server_key,\n",
        "        data.encode(),\n",
        "        hashlib.sha256\n",
        "    ).hexdigest()\n",
        "\n",
        "    return hmac.compare_digest(ticket, expected_ticket)\n",
        "\n",
        "\n",
        "# Client requests a ticket\n",
        "username = \"Alice\"\n",
        "\n",
        "username, timestamp, ticket = create_ticket(username)\n",
        "\n",
        "print(\"Username:\", username)\n",
        "print(\"Timestamp:\", timestamp)\n",
        "print(\"Ticket:\", ticket)\n",
        "\n",
        "# Server validates ticket\n",
        "if validate_ticket(username, timestamp, ticket):\n",
        "    print(\"Authentication Successful\")\n",
        "else:\n",
        "    print(\"Authentication Failed\")\n",
        "\n",
        "# Simulate expired ticket\n",
        "old_timestamp = str(int(time.time()) - 40)\n",
        "\n",
        "if validate_ticket(username, old_timestamp, ticket):\n",
        "    print(\"Old ticket accepted\")\n",
        "else:\n",
        "    print(\"Old ticket rejected\")"
